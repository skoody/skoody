// ----------------------------------------------------------------
//  AIO Hacking Tool
// ----------------------------------------------------------------
//  Author: Jules
//  Version: 1.0.0
//
//  This script is an all-in-one hacking tool for GreyHack.
//  It includes a scanner, an auto-hacker, an anti-forensics
//  cleaner, and a security radar.
//
//  Usage:
//    Run the script and use the following commands:
//    - scan [ip]
//    - hack [ip]
//    - radar
//    - help
//    - exit
// ----------------------------------------------------------------

// ================================================================
//  Global Configuration & State
// ================================================================

Database = {}

// ================================================================
//  Database Module
//
//  Handles saving and loading of collected data to a text file.
//  The user requested a .txt file, so we'll store data in a
//  structured format (like JSON) within that file.
// ================================================================

// ================================================================
//  UI / Print Helpers
// ================================================================

// Helper to print formatted alerts.
print_alert = function(message)
	print("<color=yellow><b>[!] " + message + "</b></color>")
end function

// Helper to print success messages.
print_success = function(message)
	print("<color=green><b>[+] " + message + "</b></color>")
end function

// Helper to print error messages.
print_error = function(message)
	print("<color=red><b>[-] " + message + "</b></color>")
end function

// Helper to print info messages.
print_info = function(message)
	print("<color=#6495ED><b>[*] " + message + "</b></color>")
end function

// Prints the help message for the tool.
print_help = function()
    print("")
    print("<b>AIO Tool Commands:</b>")
    print("  scan [ip]          - Scans a target IP for open ports and services.")
    print("  scanlan            - Scans your current LAN for other devices.")
    print("  hack [ip]          - Scans and attempts to exploit a target IP.")
    print("  find [ip] [pattern]- Searches for files on a target IP (requires shell access).")
    print("  radar              - Starts the security radar to monitor your system.")
    print("  help               - Shows this help message.")
    print("  exit               - Exits the tool.")
    print("")
end function

// ================================================================
//  Database Module
// ================================================================

Database.data = {}

// Gets the dynamic path for the database file.
Database.get_db_path = function()
    return home_dir + "/aio_database.txt"
end function

// Initializes the database: creates the file if it doesn't exist and loads it.
Database.init = function()
    host_computer = get_shell.host_computer
    db_path = Database.get_db_path()
    db_file = host_computer.File(db_path)

    if db_file == null then
        print_info("Database file not found. Creating a new one...")
        host_computer.touch(parent_path(db_path), "aio_database.txt")
    end if

    Database.load()
    print_success("Database initialized and loaded.")
end function

// Loads the database from the file using a simple line-based parser.
Database.load = function()
    Database.data = {"hosts":{}}
    host_computer = get_shell.host_computer
    db_file = host_computer.File(Database.get_db_path())
    if db_file == null then return

    content = db_file.get_content
    if content == null or content == "" then return

    lines = content.split(char(10))
    current_host_ip = null

    for line in lines
        if line == "" then continue
        parts = line.split(":", 3)
        key = parts[0]

        if key == "HOST_START" then
            current_host_ip = parts[1]
            if not Database.data.hosts.hasIndex(current_host_ip) then
                 Database.data.hosts[current_host_ip] = {"ports":{},"credentials":[],"files":[],"last_scanned":null}
            end if
        else if key == "HOST_END" then
            current_host_ip = null
        else if current_host_ip != null then
            if key == "LAST_SCANNED" then
                Database.data.hosts[current_host_ip].last_scanned = parts[1]
            else if key == "PORT" then
                Database.data.hosts[current_host_ip].ports[parts[1]] = parts[2]
            else if key == "CRED" then
                 Database.data.hosts[current_host_ip].credentials.push({"type":parts[1],"user":parts[2],"pass":parts[3]})
            else if key == "FILE" then
                 decoded_content = parts[2].replace("<NEWLINE>", char(10))
                 Database.data.hosts[current_host_ip].files.push({"path":parts[1],"content":decoded_content})
            end if
        end if
    end for
    print_info("Database loaded from file.")
end function

// Saves the current database state to a file using a simple line-based format.
Database.save = function()
    lines = []
    for ip in Database.data.hosts.indexes
        host = Database.data.hosts[ip]
        lines.push("HOST_START:" + ip)
        if host.last_scanned != null then lines.push("LAST_SCANNED:" + host.last_scanned)

        for port in host.ports.indexes
            lines.push("PORT:" + port + ":" + host.ports[port])
        end for

        for cred in host.credentials
            lines.push("CRED:" + cred.type + ":" + cred.user + ":" + cred.pass)
        end for

        for file in host.files
            encoded_content = file.content.replace(char(10), "<NEWLINE>")
            lines.push("FILE:" + file.path + ":" + encoded_content)
        end for

        lines.push("HOST_END:" + ip)
    end for

    host_computer = get_shell.host_computer
    db_file = host_computer.File(Database.get_db_path())
    result = db_file.set_content(lines.join(char(10)))
    if result != 1 then
        print_error("Failed to save database!")
    end if
end function

// Checks if a host exists in the database.
Database.host_exists = function(ip)
    return Database.data.hosts.hasIndex(ip)
end function

// Gets a host's data from the database.
Database.get_host = function(ip)
    if not Database.host_exists(ip) then return null
    return Database.data.hosts[ip]
end function

// Adds a new host to the database.
Database.add_host = function(ip)
    if Database.host_exists(ip) then return
    Database.data.hosts[ip] = {"ports":{},"credentials":[],"files":[],"last_scanned":null}
end function

// Adds a found file to a host's record.
Database.add_file = function(ip, filepath, content)
    if not Database.host_exists(ip) then Database.add_host(ip)
    Database.data.hosts[ip].files.push({"path":filepath,"content":content})
end function

// Adds a port to a host.
Database.add_port = function(ip, port, service)
    if not Database.host_exists(ip) then Database.add_host(ip)
    Database.data.hosts[ip].ports[str(port)] = service
    Database.data.hosts[ip].last_scanned = current_date
end function

// Adds credentials to a host.
Database.add_credential = function(ip, type, user, pass)
     if not Database.host_exists(ip) then Database.add_host(ip)
     Database.data.hosts[ip].credentials.push({"type":type,"user":user,"pass":pass})
end function

// Prints all collected loot for a specific IP.
Database.print_loot = function(ip)
    if not Database.host_exists(ip) then
        print_alert("No data found for IP: " + ip + ". Try scanning or hacking it first.")
        return
    end if

    host_data = Database.get_host(ip)
    print_info("--- Loot for " + ip + " ---")

    // Print Credentials
    if host_data.credentials and host_data.credentials.len > 0 then
        print_success("Found " + host_data.credentials.len + " credentials:")
        output = "TYPE USERNAME PASSWORD"
        for cred in host_data.credentials
            output = output + char(10) + cred.type + " " + cred.user + " " + cred.pass
        end for
        print(format_columns(output))
    else
        print_alert("No credentials found for this host.")
    end if

    print("") // Spacer

    // Print Files
    if host_data.files and host_data.files.len > 0 then
        print_success("Found " + host_data.files.len + " saved files:")
        for file in host_data.files
            print("<color=yellow><b>--- File: " + file.path + " ---</b></color>")
            print(file.content)
            print("<color=yellow><b>--- End of File ---</b></color>" + char(10))
        end for
    else
        print_alert("No saved files found for this host.")
    end if

    print_info("--- End of Loot ---")
end function

// Main function and command loop for the tool.
main = function()
    Database.init()

    print(char(10) + "<color=red><b>" + "               " + "AIO Hacking Tool" + "               " + "</b></color>")
	print("<b><color=red>" + "--------------------------------------------------" + "</color></b>")
	print("  Welcome to the All-In-One Hacking Tool (AIO)")
	print("  Version: 1.1.0")
	print("  Type 'help' for a list of commands.")
	print("<b><color=red>" + "--------------------------------------------------" + "</color></b>")


    while true
        input = user_input(char(10) + "<color=green>AIO</color> > ")
        if input == null or input == "" then continue

        parts = input.split(" ")
        command = parts[0].lower

        if command == "scan" then
            if parts.len < 2 then
                print_error("Usage: scan [target_ip]")
            else
                UniversalScanner.scan(parts[1])
            end if
        else if command == "scanlan" then
            UniversalScanner.scanlan()
        else if command == "hack" then
            if parts.len < 2 then
                print_error("Usage: hack [target_ip]")
            else
                AutoHacker.hack(parts[1])
            end if
        else if command == "find" then
            if parts.len < 3 then
				print_error("Usage: find [target_ip] [pattern]")
			else
				FileFinder.search(parts[1], parts[2])
			end if
        else if command == "radar" then
            SecurityRadar.start()
        else if command == "help" then
            print_help()
        else if command == "exit" then
            exit("AIO Tool terminated.")
        else
            print_error("Unknown command. Type 'help' for a list of commands.")
        end if
    end while
end function

// ================================================================
//  Modules (to be implemented)
// ================================================================

SecurityRadar = {}
SecurityRadar.last_log_size = 0

// Starts the continuous monitoring of the local machine's logs.
SecurityRadar.start = function()
    print_info("Security Radar activated. Monitoring local logs...")
    my_ip = get_shell.host_computer.public_ip

    while true
        log_file = get_shell.host_computer.File("/var/system.log")
        if log_file == null then
            print_error("/var/system.log not found. Cannot monitor.")
            return
        end if

        log_content = log_file.get_content
        if log_content == null or log_content == "" then
            wait(5) // Wait longer if log is empty
            continue
        end if

        lines = log_content.split(char(10))
        current_log_size = lines.len

        if SecurityRadar.last_log_size == 0 then // First run
            SecurityRadar.last_log_size = current_log_size
        else if current_log_size > SecurityRadar.last_log_size then
            new_lines = lines[SecurityRadar.last_log_size:]
            print_alert("--- NEW SECURITY ALERTS ---")
            for line in new_lines
                // Very basic parsing logic. This would need to be improved
                // based on the actual log format.
                if line.indexOf("Connection established from") != null then
                    parts = line.split("from ")
                    if parts.len > 1 and parts[1] != my_ip then
                        print_alert("Foreign login detected from " + parts[1])
                    end if
                else if line.indexOf("Port scan") != null then
                     parts = line.split("from ")
                     if parts.len > 1 then
                         print_alert("Port scan detected from " + parts[1])
                     end if
                else if line.indexOf("exploit attempt") != null or line.indexOf("overflow") != null then
                     parts = line.split("from ")
                     if parts.len > 1 then
                         print_alert("Exploit attempt detected from " + parts[1])
                     end if
                end if
            end for
            SecurityRadar.last_log_size = current_log_size
        end if

        wait(2) // Check logs every 2 seconds
    end while
end function

UniversalScanner = {}
UniversalScanner.scan = function(target_ip)
    // --- DIG Cache Logic ---
    host_data = Database.get_host(target_ip)
    if host_data != null and host_data.last_scanned != null then
        print_info("Host " + target_ip + " has been scanned recently (" + host_data.last_scanned + "). Using cached data.")
        if host_data.ports.len == 0 then
			print_info("  No open ports found in cache.")
			return
		end if

		print_info("Known open ports:")
		output = "PORT SERVICE"
		for port in host_data.ports.indexes
			output = output + char(10) + port + " " + host_data.ports[port]
		end for
		print(format_columns(output))

        return
    end if
    // --- End DIG Cache Logic ---

    print_info("Scanning " + target_ip + "...")

    if not is_lan_ip(target_ip) then
		print_info("Performing whois lookup...")
		whois_info = whois(target_ip)
		if whois_info and whois_info != "No Info available" then
			print(whois_info)
		else
			print_alert("No whois information available for " + target_ip)
		end if
	end if

    router = get_router(target_ip)
    if router == null then
        print_error("Could not get router for IP " + target_ip + ". Is the IP valid and reachable?")
        return
    end if

    ports = router.used_ports
    if ports == null or ports.len == 0 then
        print_alert("No open ports found on " + target_ip)
        Database.add_host(target_ip) // Add host to DB even if no ports are open, to avoid re-scanning
        Database.data.hosts[target_ip].last_scanned = current_date
        Database.save()
        return
    end if

    print_success("Open ports on " + target_ip + ":")
	output = "PORT SERVICE"
    found_ports = false
    for port in ports
        if not port.is_closed then
            found_ports = true
            port_num = port.port_number
            service_info = router.port_info(port)

            if service_info != null and service_info != "" then
                service_name = service_info.split(" ")[0]
				output = output + char(10) + port_num + " " + service_name
                Database.add_port(target_ip, port_num, service_name)
            else
				output = output + char(10) + port_num + " unknown"
                Database.add_port(target_ip, port_num, "unknown")
            end if
        end if
    end for
	print(format_columns(output))


    if not found_ports then
        print_alert("No open ports found on " + target_ip)
        Database.add_host(target_ip) // Add host to DB even if no ports are open, to avoid re-scanning
    end if

    Database.data.hosts[target_ip].last_scanned = current_date
    Database.save()
    print_success("Scan complete for " + target_ip)
end function

UniversalScanner.scanlan = function()
	print_info("Scanning current LAN for devices...")

	my_computer = get_shell.host_computer
	if not my_computer.is_network_active then
		print_error("You are not connected to any network.")
		return
	end if

	// 1. Get the Gateway IP from the computer. This is the router's LAN IP.
	gateway_ip = my_computer.network_gateway()
	if gateway_ip == null or gateway_ip == "" then
		print_error("Could not determine this network's gateway IP. Cannot scan LAN.")
		return
	end if

	// 2. Use the Gateway IP to get the router object.
	my_router = get_router(gateway_ip)
	if my_router == null then
		print_error("Could not get router object using gateway IP: " + gateway_ip)
		return
	end if

	// 3. Get the list of devices using the `devices_lan_ip()` function.
	lan_ips = my_router.devices_lan_ip()
	if lan_ips == null then
		print_error("Could not retrieve device list from router. The 'devices_lan_ip()' function may not be available.")
		return
	end if

	// 4. Get our own IP for filtering.
	my_lan_ip = my_computer.local_ip()
	if my_lan_ip == null or my_lan_ip == "" then
	    print_error("Could not determine your own LAN IP via local_ip().")
	    return
	end if

	// Filter out the player's own computer from the list
	other_devices = []
	for ip in lan_ips
		if ip != my_lan_ip then other_devices.push(ip)
	end for

	if other_devices.len == 0 then
		print_alert("No other devices found on your current LAN.")
		return
	end if

	print_success("Found " + other_devices.len + " other devices on the LAN:")
	output = "IP_ADDRESS SERVICE PORTS"

	for ip in other_devices
		// For each discovered IP, perform a full, detailed scan just like the `scan` command.
		device_router = get_router(ip)
		if device_router == null then
			output = output + char(10) + ip + " " + "Unknown" + " " + "Router unreachable"
			continue
		end if

		ports = device_router.used_ports
		if ports == null or ports.len == 0 then
			output = output + char(10) + ip + " " + "None" + " " + "No open ports"
			continue
		end if

		ports_info = {}
		found_ports = false
		for port in ports
			if not port.is_closed then
				found_ports = true
				port_num = port.port_number
				service_info = device_router.port_info(port)
				service_name = "unknown"

				if service_info != null and service_info != "" then
					service_name = service_info.split(" ")[0]
				end if

				if not ports_info.hasIndex(service_name) then ports_info[service_name] = []
				ports_info[service_name].push(port_num)
				Database.add_port(ip, port_num, service_name)
			end if
		end for

		if not found_ports then
			output = output + char(10) + ip + " " + "None" + " " + "No open ports"
		else
			// Consolidate ports by service for cleaner output
			for service in ports_info.indexes
				output = output + char(10) + ip + " " + service + " " + ports_info[service].join(", ")
			end for
		end if
	end for

	Database.save() // Save all the new port info we found
	print(format_columns(output))
	print_success("LAN scan complete.")
end function

AutoHacker = {}

// Generates a random alphanumeric password.
AutoHacker.generate_password = function(length)
    chars = "abcdefghijklmnopqrstuvwxyz0123456789"
    password = ""
    for i in range(length)
        password = password + chars[floor(rnd * chars.len)]
    end for
    return password
end function

// Main function to orchestrate the hack against a target IP.
AutoHacker.hack = function(target_ip)
    print("")
    print_info("--- Starting hack on " + target_ip + " ---")

    // Step 1: Ensure we have scan data.
    if not Database.host_exists(target_ip) or Database.get_host(target_ip).last_scanned == null then
        print_info("Host not in database or not scanned. Scanning first...")
        UniversalScanner.scan(target_ip)
    end if

    host_data = Database.get_host(target_ip)
    if host_data == null or host_data.ports.len == 0 then
        print_alert("No open ports found for " + target_ip + ". Cannot proceed with exploit scan.")
        return
    end if

    print_info("Beginning exploit scan on " + host_data.ports.len + " open ports.")

    // Step 2: Attempt to exploit services on open ports.
    metax = include_lib("/lib/metaxploit.so")
    if metax == null then
        print_error("Metaxploit library not found. Aborting.")
        return
    end if

    for port_str in host_data.ports.indexes
        port_num = port_str.to_int
        print_info("  -> Probing port " + port_num + "...")
        net_session = metax.net_use(target_ip, port_num)

        if net_session == null then continue

        meta_lib = net_session.dump_lib()
        if meta_lib == null then continue

        print_info("    Found library: " + meta_lib.lib_name + " v" + meta_lib.version)
        vuln_areas = metax.scan(meta_lib)

        if vuln_areas == null or vuln_areas.len == 0 then continue

        print_success("    Found " + vuln_areas.len + " potential vulnerabilities. Analyzing...")

        for area in vuln_areas
            details = metax.scan_address(meta_lib, area)

            exploit_name = null
            requirement = null

            // 1. Parse exploit name
            name_segments = details.split("<b>")
            if name_segments.len > 1 then
                exploit_name = name_segments[1].split("</b>")[0]
            end if
            if exploit_name == null then continue

            // 2. Parse requirement
            if details.indexOf("*Requires:") != -1 then
                req_segments = details.split("\*Requires:")
                if req_segments.len > 1 then
                    requirement = req_segments[1].trim.split(" ")[0].lower
                end if
            end if

            print_success("      Found exploit: " + exploit_name + " (Requirement: " + (requirement or "None") + ")")

            // 3. Prepare optArgs and decide if we can attempt the exploit
            optArgs = "" // Default to empty string to avoid "Invalid arguments" error
            can_attempt = true // Be optimistic and attempt exploit by default

            if requirement == "password" then
                optArgs = AutoHacker.generate_password(8)
                print_info("        Generated password for exploit: " + optArgs)
            else if requirement == "lan_ip" then
                port_object = router.ping_port(port_num)
                if port_object != null then
                    optArgs = port_object.get_lan_ip
                    if optArgs != null and optArgs != "" then
                       print_info("        Found LAN IP for exploit: " + optArgs)
                    else
                       print_error("        Could not determine LAN IP. Skipping exploit.")
                       can_attempt = false // We know the req but can't fulfill it
                    end if
                else
                    print_error("        Could not ping port to find LAN IP. Skipping exploit.")
                    can_attempt = false // We know the req but can't fulfill it
                end if
            end if
            // For null or other unknown requirements, we will still try with empty optArgs.

            if can_attempt then
                print_info("      Attempting exploit: " + exploit_name)
                result = meta_lib.overflow(area, exploit_name, optArgs)

                if result != null then
                    print_success("      [SUCCESS] Exploit successful!")
                    if typeof(result) == "shell" then
                        print_success("        Got a shell! Proceeding with post-exploitation...")
                        AutoHacker.crack_passwords(result, target_ip)

                        print_info("        Running automated file search for sensitive files...")
                        FileFinder.found_files = []
                        FileFinder.recursive_search(result.host_computer.File("/"), "pass")
                        FileFinder.recursive_search(result.host_computer.File("/"), ".conf")
                        FileFinder.recursive_search(result.host_computer.File("/"), "key")
                        if FileFinder.found_files.len > 0 then
                            print_success("        Found " + FileFinder.found_files.len + " potentially sensitive files:")
                            output = "PATH SIZE PERMISSIONS"
                            for file in FileFinder.found_files
                                output = output + char(10) + file.path + " " + file.size + " " + file.permissions
                            end for
                            print(format_columns(output))
                        else
                            print_alert("        No sensitive files found.")
                        end if

                        // --- Privilege Escalation ---
                        root_creds = null
                        for cred in Database.get_host(target_ip).credentials
                            if cred.user == "root" then
                                root_creds = cred
                                break
                            end if
                        end for

                        if root_creds then
                            print_info("        Found root credentials. Attempting to escalate to a root shell...")
                            root_shell = get_shell.connect_service(target_ip, 22, root_creds.user, root_creds.pass)
                            if root_shell then
                                print_success("        Privilege escalation successful! Now running as root.")
                                AutoHacker.create_backdoor(root_shell, target_ip)
                                AntiForensics.clean(root_shell)
                            else
                                print_error("        Root login failed. Continuing with user-level shell.")
                                AutoHacker.create_backdoor(result, target_ip)
                                AntiForensics.clean(result)
                            end if
                        else
                            print_alert("        No root credentials cracked. Cannot escalate privileges.")
                            AutoHacker.create_backdoor(result, target_ip)
                            AntiForensics.clean(result)
                        end if
                        // --- End Privilege Escalation ---

                        Database.save()
                        print_success("--- Hack finished on " + target_ip + " ---")
                        return
                    else if typeof(result) == "file" then
                        print_info("        Got a file! Analyzing...")
                        filepath = result.path
                        if result.has_permission("r") then
                            content = result.get_content
                            print_info("        File path: " + filepath)
                            print_info("        File content: " + content)
                            Database.add_file(target_ip, filepath, content)
                            Database.save()
                            print_success("        File saved to database.")
                        else
                            print_alert("        Got file at '" + filepath + "' but don't have read permissions.")
                        end if
                    else
                        print_alert("        Exploit returned a " + typeof(result) + ". Handling not yet implemented.")
                    end if
                end if
            end if
        end for
    end for

    print_info("--- Hack finished on " + target_ip + " ---")
end function

// Helper function to get a shell on a target using stored credentials.
AutoHacker.get_shell_with_creds = function(target_ip)
	host_data = Database.get_host(target_ip)
	if host_data == null or host_data.credentials.len == 0 then
		print_alert("No credentials found in the database for " + target_ip)
		return null
	end if

	print_info("Attempting to get a shell using " + host_data.credentials.len + " stored credentials...")
	my_shell = get_shell
	for cred in host_data.credentials
		if cred.type == "user" then
			print_info("  Trying " + cred.user + ":" + cred.pass)
			remote_shell = my_shell.connect_service(target_ip, 22, cred.user, cred.pass)
			if remote_shell then
				print_success("  Successfully connected as " + cred.user)
				return remote_shell
			end if
		end if
	end for

	print_error("None of the stored credentials worked.")
	return null
end function

// Helper function to crack passwords from /etc/passwd if we get a shell.
AutoHacker.crack_passwords = function(shell, target_ip)
    computer = shell.host_computer
    if computer == null then return

    passwd_file = computer.File("/etc/passwd")
    if passwd_file == null or not passwd_file.has_permission("r") then
        print_alert("        Could not read /etc/passwd. Aborting password crack.")
        return
    end if

    content = passwd_file.get_content
    if content == null or content == "" then return

    print_info("        Cracking hashes from /etc/passwd...")
    crypto = include_lib("/lib/crypto.so")
    if crypto == null then
        print_error("        Crypto library not found. Cannot decipher passwords.")
        return
    end if

    lines = content.split(char(10))
    for line in lines
        if line == "" then continue
        parts = line.split(":")
        if parts.len < 2 then continue

        username = parts[0]
        hash = parts[1]

        if hash != "x" and hash != "" then
            password = crypto.decipher(hash)
            if password != null then
                print_success("          [!!!] Cracked: " + username + ":" + password)
                Database.add_credential(target_ip, "user", username, password)
            end if
        end if
    end for
end function

AutoHacker.create_backdoor = function(shell, target_ip)
    print_info("        Attempting to create a backdoor user...")

    backdoor_user = "svc_" + AutoHacker.generate_password(6)
    backdoor_pass = AutoHacker.generate_password(12)

    result = shell.host_computer.create_user(backdoor_user, backdoor_pass)
    if result == 1 then
        print_success("        Backdoor user created: " + backdoor_user + ":" + backdoor_pass)
        Database.add_credential(target_ip, "user", backdoor_user, backdoor_pass)
    else
        print_error("        Failed to create backdoor user: " + result)
    end if
end function

AntiForensics = {}

// Cleans up traces from a remote computer after a successful hack.
AntiForensics.clean = function(shell)
    if shell == null then return
    print_info("      Starting anti-forensics cleanup...")

    computer = shell.host_computer

    // 1. Delete /var/log
    log_file = computer.File("/var/log")
    if log_file != null then
        result = log_file.delete
        if result == "" then
            print_success("        - /var/log deleted successfully.")
        else
            print_error("        - Failed to delete /var/log: " + result)
        end if
    end if

    // 2. Truncate .bash_history for all users.
    home_folder = computer.File("/home")
    if home_folder and home_folder.is_folder then
        user_folders = home_folder.get_folders
        if user_folders then
            for user_folder in user_folders
                history_file = computer.File(user_folder.path + "/.bash_history")
                if history_file then
                    history_file.set_content("")
                end if
            end for
            print_success("        - Cleaned user .bash_history files.")
        end if
    end if

    // Clean root's history as well
    root_history = computer.File("/root/.bash_history")
    if root_history then
        root_history.set_content("")
        print_success("        - /root/.bash_history truncated.")
    end if


    // 3. Clean /tmp directory
    tmp_folder = computer.File("/tmp")
    if tmp_folder != null and tmp_folder.is_folder then
        // Delete files in /tmp
        files = tmp_folder.get_files
        if files != null then
            for file in files
                file.delete
            end for
        end if

        // Delete folders in /tmp
        folders = tmp_folder.get_folders
        if folders != null then
            for folder in folders
                folder.delete
            end for
        end if
        print_success("        - /tmp directory cleaned.")
    end if

    print_info("      Anti-forensics cleanup complete.")
end function

// ================================================================
//  File Finder Module
// ================================================================

FileFinder = {}
FileFinder.found_files = []

FileFinder.search = function(target_ip, pattern)
    print_info("Starting file search on " + target_ip + " for pattern: " + pattern)

    // Step 1: Get a shell. We need access to the file system.
    shell = AutoHacker.get_shell_with_creds(target_ip)
    if shell == null then
        print_error("Could not get a shell on " + target_ip + ". Cannot perform file search.")
        print_alert("Try running the 'hack' command first to gain access and credentials.")
        return
    end if

    print_success("Got a shell on " + target_ip + ". Starting recursive search from '/'...")
    FileFinder.found_files = []
    FileFinder.recursive_search(shell.host_computer.File("/"), pattern)

    if FileFinder.found_files.len == 0 then
        print_alert("No files found matching the pattern '" + pattern + "'.")
    else
        print_success("Found " + FileFinder.found_files.len + " matching files:")
        output = "PATH SIZE PERMISSIONS"
        for file in FileFinder.found_files
            output = output + char(10) + file.path + " " + file.size + " " + file.permissions
        end for
        print(format_columns(output))
    end if
    print_success("File search complete.")
end function

FileFinder.recursive_search = function(directory, pattern)
    if directory == null or not directory.is_folder then return

    // Search files in the current directory
    files = directory.get_files
    if files != null then
        for file in files
            if file.name.indexOf(pattern) != null or pattern == "*" then
                FileFinder.found_files.push(file)
            end if
        end for
    end if

    // Recurse into subdirectories
    folders = directory.get_folders
    if folders != null then
        for folder in folders
            FileFinder.recursive_search(folder, pattern)
        end for
    end if
end function


// ================================================================
//  Script Entry Point
// ================================================================

main()
